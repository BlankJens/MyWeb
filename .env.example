# ==============================================================================
# RENDER (producao) -- copie para ".env" e preencha. O ".env" esta no .gitignore.
# ==============================================================================

# A connection string do Aiven NAO pode ser usada direto: ela vem como
# "mysql://usuario:senha@host:porta/defaultdb" e o driver JDBC recusa esse
# formato ("No suitable driver found for mysql://...").
#
# Monte a URL JDBC assim:
#   1. Aiven Console > seu servico > Connection information
#   2. Copie host, port, user, password e o banco (geralmente "defaultdb")
#   3. Cole no formato abaixo, com o prefixo "jdbc:mysql://"
#
# O sslMode=REQUIRED e obrigatorio: o Aiven so aceita conexao com SSL.
JDBC_URL=jdbc:mysql://SEU-HOST-AIVEN:SUA-PORTA/defaultdb?sslMode=REQUIRED&allowPublicKeyRetrieval=true
DB_USER=SEU-USUARIO
DB_PASSWORD=SUA-SENHA

# A porta nao precisa ser definida: o Render injeta PORT e o app ja le.

# ==============================================================================
# CLOUDINARY -> https://console.cloudinary.com/settings/api-keys
# ==============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OPCIONAL. O upload e assinado (feito no backend com api_key/api_secret),
# entao o preset nao e necessario -- recomendado deixar vazio.
# Se for usar, crie um preset do tipo SIGNED (nao unsigned) no console.
CLOUDINARY_UPLOAD_PRESET=
