# Credenciais do Cloudinary -> https://console.cloudinary.com/settings/api-keys
# Copie este arquivo para ".env" e preencha. O ".env" esta no .gitignore.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OPCIONAL. O upload e assinado (feito no backend com api_key/api_secret),
# entao o preset nao e necessario -- recommended deixar vazio.
# Se for usar, crie um preset do tipo SIGNED (nao unsigned) na aba
# Upload Presets do console. As duas primeiras opcoes sao obrigatorias.
CLOUDINARY_UPLOAD_PRESET=
